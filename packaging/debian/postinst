#!/bin/sh
set -e

case "$1" in
    configure)
        # Storage dir, root-only (contains the encryption key).
        mkdir -p /var/lib/hiro
        chmod 700 /var/lib/hiro

        # Dedicated group for non-root camera access (`hiro doctor`); the
        # udev rule grants camera nodes to this group, not to `video`.
        if ! getent group hiro >/dev/null 2>&1; then
            if command -v groupadd >/dev/null 2>&1; then
                groupadd --system hiro
            elif command -v addgroup >/dev/null 2>&1; then
                addgroup --system hiro
            fi
        fi

        # PAM opt-in profile.
        if command -v pam-auth-update >/dev/null 2>&1; then
            DEBIAN_FRONTEND=noninteractive pam-auth-update --package
        fi

        # polkit >= 127 sandbox compatibility.
        if [ -d /etc/systemd/system/polkit-agent-helper@.service.d ]; then :; else
            mkdir -p /etc/systemd/system/polkit-agent-helper@.service.d
        fi
        cp -n /usr/share/hiro/polkit-agent-helper-hiro.conf \
            /etc/systemd/system/polkit-agent-helper@.service.d/hiro.conf || true

        if [ -x /usr/bin/deb-systemd-helper ]; then
            deb-systemd-helper enable hirod.service hirod-resume.service >/dev/null || true
        fi

        # Per-user session UI: enable the user unit globally so every
        # graphical session picks it up (the XDG autostart entry covers
        # sessions without a systemd user manager; hiro-ui's single-instance
        # guard makes double launch harmless). Failures are fine on systems
        # without systemd --user.
        if command -v systemctl >/dev/null 2>&1; then
            systemctl --global enable hiro-ui.service >/dev/null 2>&1 || true
        fi
    ;;
    abort-upgrade|abort-remove|abort-deconfigure) ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

#DEBHELPER#
exit 0
